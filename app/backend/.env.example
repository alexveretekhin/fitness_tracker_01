# Скопируй в .env и поменяй при необходимости. .env в git не попадает.
DATABASE_URL=sqlite:///./fitness.db
CORS_ORIGINS=["http://localhost:5173"]
# Секрет для подписи токенов входа (JWT). На сервере обязательно свой:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-secret-change-me-in-env-file-please
TOKEN_DAYS=30
