{
  "name": "fitness-tracker-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "biome check .",
    "format": "biome check --write .",
    "api": "cd ../backend && uv run python -m app.export_openapi ../frontend/openapi.json && cd ../frontend && openapi-ts",
    "test": "vitest run",
    "dev:https": "vite --host --mode https"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "^5.3.1",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "1.170.46",
    "motion": "^12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
