      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Новый аккаунт. Если регистрируется гость, его тренировки переходят в аккаунт.",
        "operationId": "register",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterIn"
              }
            }
