{
  "openapi": "3.1.0",
  "info": {
    "title": "Fitness Tracker API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "description": "Проверка, что сервер жив.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/muscle-groups": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Muscle Groups",
        "operationId": "list_muscle_groups",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MuscleGroupOut"
                  },
                  "type": "array",
                  "title": "Response List Muscle Groups"
                }
              }
            }
          }
        }
      }
    },
    "/api/muscle-groups/{group_id}/exercises": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Group Exercises",
        "description": "Упражнения, где эта группа — основная. Это же будет звать 3D-аватар.",
        "operationId": "list_group_exercises",
        "parameters": [
          {
            "name": "group_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Group Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExerciseOut"
                  },
                  "title": "Response List Group Exercises"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/exercises": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Search Exercises",
        "description": "Поиск упражнений по названию: /exercises?q=bench",
        "operationId": "search_exercises",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ExerciseOut"
                  },
                  "title": "Response Search Exercises"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/days": {
      "get": {
        "tags": [
          "days"
        ],
        "summary": "List Days",
        "description": "Сводка по дням для ленты недели и истории: /days?from=2026-10-20&to=2026-10-28",
        "operationId": "list_days",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "From"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "To"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DaySummary"
                  },
                  "title": "Response List Days"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/days/{date}": {
      "get": {
        "tags": [
          "days"
        ],
        "summary": "Get Day",
        "operationId": "get_day",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/days/{date}/exercises": {
      "post": {
        "tags": [
          "days"
        ],
        "summary": "Add Exercise",
        "description": "Добавить упражнение в день (то самое «улетает на главную»).",
        "operationId": "add_exercise",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Date"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddExerciseIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/days/{date}/exercises/{exercise_id}": {
      "put": {
        "tags": [
          "days"
        ],
        "summary": "Save Log",
        "description": "Сохранить вес, подходы и повторы из карточки.",
        "operationId": "save_log",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Date"
            }
          },
          {
            "name": "exercise_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Exercise Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetLogIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "days"
        ],
        "summary": "Remove Exercise",
        "operationId": "remove_exercise",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Date"
            }
          },
          {
            "name": "exercise_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Exercise Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DayOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Get Me",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "me"
        ],
        "summary": "Update Me",
        "operationId": "update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddExerciseIn": {
        "properties": {
          "exercise_id": {
            "type": "string",
            "title": "Exercise Id"
          }
        },
        "type": "object",
        "required": [
          "exercise_id"
        ],
        "title": "AddExerciseIn"
      },
      "Avatar": {
        "type": "string",
        "enum": [
          "male",
          "female"
        ],
        "title": "Avatar"
      },
      "DayExerciseOut": {
        "properties": {
          "exercise_id": {
            "type": "string",
            "title": "Exercise Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "weight": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight"
          },
          "sets": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sets"
          },
          "reps": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reps"
          }
        },
        "type": "object",
        "required": [
          "exercise_id",
          "name",
          "weight",
          "sets",
          "reps"
        ],
        "title": "DayExerciseOut"
      },
      "DayOut": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "done": {
            "type": "boolean",
            "title": "Done"
          },
          "exercises": {
            "items": {
              "$ref": "#/components/schemas/DayExerciseOut"
            },
            "type": "array",
            "title": "Exercises"
          }
        },
        "type": "object",
        "required": [
          "date",
          "done",
          "exercises"
        ],
        "title": "DayOut"
      },
      "DaySummary": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "done": {
            "type": "boolean",
            "title": "Done"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "date",
          "done",
          "count"
        ],
        "title": "DaySummary"
      },
      "ExerciseOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "demo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Demo"
          },
          "primary_muscles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Primary Muscles"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "demo",
          "primary_muscles"
        ],
        "title": "ExerciseOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MeOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "avatar": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Avatar"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "avatar"
        ],
        "title": "MeOut"
      },
      "MeUpdate": {
        "properties": {
          "avatar": {
            "$ref": "#/components/schemas/Avatar"
          }
        },
        "type": "object",
        "required": [
          "avatar"
        ],
        "title": "MeUpdate"
      },
      "MuscleGroupOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "MuscleGroupOut"
      },
      "SetLogIn": {
        "properties": {
          "weight": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Weight"
          },
          "sets": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Sets"
          },
          "reps": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Reps"
          }
        },
        "type": "object",
        "required": [
          "weight",
          "sets",
          "reps"
        ],
        "title": "SetLogIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
